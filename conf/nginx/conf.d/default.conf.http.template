# ============================================================
# HTTP 範本（純 HTTP，無 SSL）
# 使用情境：本機開發、IP 直連、或由外部服務（如 Cloudflare Proxy）在外層處理 SSL
#
# 啟用方式 (.env)：
#   NGINX_MODE=http
#   DOMAIN=_             ← _ 代表接受任何域名（IP 直連時使用）
#   DOMAIN=example.com   ← 指定域名則只接受該域名的請求
# ============================================================
upstream flask_app {
    server api:${FLASK_PORT};
}

server {
    listen      80;
    server_name ${DOMAIN};

    client_max_body_size 20M;

    access_log  /var/log/nginx/access.log;
    error_log   /var/log/nginx/error.log;

    # ── 還原真實訪客 IP ─────────────────────────────────────────
    # 這個容器前面若還有一層反向代理（主機 nginx，經 Docker 網路連進來，來源是 Docker 閘道
    # 172.x）。只信任 Docker 私有網段送來的 X-Forwarded-For，從右往左跳過可信的代理，取第一個
    # 不可信的位址當訪客 IP（recursive）——這樣 $remote_addr、下面轉給 api 的 X-Real-IP／
    # X-Forwarded-For 才是訪客本人，api 的 ProxyFix(x_for=1)、登入失敗鎖定、操作紀錄 IP、
    # 限流才不會全站共用一個 IP。外部直接連進來的請求來源是公網 IP（不在信任範圍），
    # 自己帶的 X-Forwarded-For 不會被採信。
    # ⚠️ Docker 若關掉 iptables、改用 userland-proxy 對外發佈這個埠，所有外部連線的來源都會變成
    #    閘道 IP，這時不要讓這個容器直接對外。
    set_real_ip_from 172.16.0.0/12;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        proxy_pass         http://flask_app;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout  60s;
        proxy_send_timeout     60s;
        proxy_read_timeout     60s;
    }

    location /nginx-health {
        access_log  off;
        return      200 "ok\n";
        add_header  Content-Type text/plain;
    }
}
