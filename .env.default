FLASK_PORT=5000
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# ── CORS 允許來源（逗號分隔，填入生產域名；開發時 localhost:5173 已內建）
# CORS_ORIGIN=https://your-domain.com

# ── 初始管理員帳號密碼（首次啟動建立 admin 帳號時使用，建立後修改不影響已存在帳號）
ADMIN_PASSWORD=admin

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=flask_app
MYSQL_USER=flask_user
MYSQL_PASSWORD=flask_password

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password

# ── 星際公民遊戲資料（社群 API，非官方）─────────────────────────
# UEX Corp API token。留空則跳過 UEX 同步，價格改用 Wiki API 內嵌資料（較少）。
# 免費申請：https://uexcorp.space/api/apps
UEX_API_TOKEN=

# ── 倉庫管理（WMS）────────────────────────────────────────────
# 庫存範圍。Web 與 Discord bot 共用同一個值才會看到同一份庫存。
WMS_SCOPE_ID=default

# 動「公會共享庫」需要的 Discord 角色名稱或角色 ID。
# 留空 = 所有人都能入出庫；個人庫永遠只有本人能動，不受此設定影響。
WMS_OPERATOR_ROLE=

# ── Discord bot ──────────────────────────────────────────────
# https://discord.com/developers/applications → 你的 app → Bot → Reset Token
# 留空時 bot 容器會直接結束（不影響 api / worker）
DISCORD_TOKEN=

# Discord 伺服器 ID（開發者模式下右鍵伺服器 → 複製伺服器 ID）
# 填了斜線指令立即生效；留空則註冊全域指令，傳播最久要等約一小時
DISCORD_GUILD_ID=

# ── 正式環境 DB_SERVER（供 ProductionConfig 使用）
# DB_SERVER=127.0.0.1

# ── nginx 模式 ────────────────────────────────────────────────
# 可選值：
#   http                — 純 HTTP，本機或無域名環境使用（預設）
#   cloudflare          — Cloudflare Origin CA SSL（需準備 origin.pem / origin.key）
#   https-letsencrypt   — Let's Encrypt SSL（需額外 certbot 設定，見範本檔說明）
NGINX_MODE=http

# 對外域名（http 模式保持 _ 即可；啟用 SSL 時填入實際域名）
DOMAIN=_

# Cloudflare Origin CA 憑證所在目錄（NGINX_MODE=cloudflare 時填）
# 需事先將 origin.pem / origin.key 放入此目錄
CF_CERT_DIR=./conf/nginx/certs/cloudflare
