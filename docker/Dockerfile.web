# 玩家／藍圖／戰利品前端（web 容器）。比照 docker/Dockerfile 的 multi-stage 作法，
# 讓 `docker-compose up --build` 自動打包，不需要手動在本機跑 npm run build:web。

# ── Stage 1: 打包 Vue 3 前端（web build，base '/'）────────────────
FROM node:22-alpine AS frontend-builder

WORKDIR /build/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --silent

COPY frontend/ ./

# vite.config.web.js 的 outDir = 'dist-web'
RUN npm run build:web


# ── Stage 2: nginx 服務打包好的靜態檔 ──────────────────────────────
FROM nginx:1.26-alpine

COPY --from=frontend-builder /build/frontend/dist-web/ /usr/share/nginx/html/
COPY conf/nginx-web/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
